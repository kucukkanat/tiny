{
  "plugins": ["react", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "packages/ui/src/components",
    "packages/ui/src/hooks",
    ".claude"
  ]
}
