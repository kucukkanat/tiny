{
  "name": "tiny",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @tiny/chat dev",
    "build": "bun run --filter @tiny/chat build",
    "build:site": "bun run scripts/build-site.ts",
    "docs": "bun run --filter @tiny/docs dev",
    "mock": "bun run scripts/mock-endpoint.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.3.14",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.9.0"
  }
}
