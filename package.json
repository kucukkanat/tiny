{
  "name": "tiny",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @tiny/app dev",
    "build": "bun --filter @tiny/app build",
    "preview": "bun --filter @tiny/app preview",
    "test": "bun test",
    "typecheck": "tsc",
    "lint": "oxlint",
    "deadcode": "knip-bun",
    "deadcode:fix": "knip-bun --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "knip": "^6.34.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2"
  }
}
